{
  "manifest_version": 3,
  "name": "Threads Quick Block",
  "version": "0.1.0",
  "description": "One-click block button on Threads posts.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://www.threads.net/*"],
  "content_scripts": [
    {
      "matches": ["https://www.threads.net/*"],
      "js": ["src/content.ts"],
      "run_at": "document_idle"
    }
  ]
}
